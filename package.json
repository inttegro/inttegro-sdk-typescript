{
  "name": "@inttegro/inttegro-sdk",
  "version": "10.0.0",
  "description": "Official TypeScript SDK for the Inttegro API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "docs": "typedoc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "api",
    "inttegro",
    "communications",
    "marketing",
    "payments",
    "sdk",
    "typescript",
    "mobile-money"
  ],
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inttegro/inttegro-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/inttegro/inttegro-sdk-typescript/issues"
  },
  "homepage": "https://typescript.inttegro.dev/",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "fast-check": "4.9.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.0",
    "typedoc": "0.28.20",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}

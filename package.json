{
  "name": "@inttegro/inttegro-sdk",
  "version": "12.0.0",
  "description": "Official TypeScript SDK for the Inttegro API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "docs": "typedoc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "checkout",
    "commerce",
    "ecommerce",
    "fintech",
    "ghana",
    "ghs",
    "inttegro",
    "mobile-money",
    "payments",
    "sdk",
    "typescript"
  ],
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inttegro/inttegro-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/inttegro/inttegro-sdk-typescript/issues"
  },
  "homepage": "https://typescript.inttegro.dev/",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "fast-check": "4.10.2",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typedoc": "0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
